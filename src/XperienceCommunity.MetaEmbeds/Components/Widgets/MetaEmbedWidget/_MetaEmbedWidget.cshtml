@using XperienceCommunity.MetaEmbeds.Rendering
@using XperienceCommunity.MetaEmbeds.Widgets
@model MetaEmbedWidgetViewModel

@if (Model is null)
{
    return;
}

@if (!string.IsNullOrEmpty(Model.EditorMessage))
{
    @* Editor-only state (edit / read-only / preview). The live site renders nothing for failures. *@
    <div class="meta-embed meta-embed--message" role="status" style="border: 1px dashed #8a8a8a; border-radius: 4px; padding: 12px 16px; font: 14px/1.5 sans-serif; color: #444; background: #fafafa;">
        @Model.EditorMessage
    </div>
}
else if (!string.IsNullOrEmpty(Model.Html))
{
    var cssClass = string.IsNullOrEmpty(Model.EndpointKey)
        ? "meta-embed"
        : "meta-embed meta-embed--" + Model.EndpointKey;

    if (Model.EmitFacebookRoot)
    {
        <div id="fb-root"></div>
    }

    if (Model.IsEditMode)
    {
        @* The transparent overlay keeps the embed's iframe from swallowing Page Builder drag and click events. *@
        <div class="@cssClass" style="position: relative;">
            <div style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1000;"></div>
            @Html.Raw(Model.Html)
        </div>
    }
    else
    {
        <div class="@cssClass">
            @Html.Raw(Model.Html)
        </div>
    }

    foreach (var script in Model.ScriptsToEmit)
    {
        @Html.Raw(EmbedScriptTag.Render(script))
    }
}

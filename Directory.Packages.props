<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <ItemGroup Label="Xperience by Kentico">
    <PackageVersion Include="Kentico.Xperience.WebApp" Version="31.8.3" />
    <PackageVersion Include="Kentico.Xperience.Core.Tests" Version="31.8.3" />
  </ItemGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="AngleSharp.Css" Version="1.0.1" />
    <!-- Match the HtmlSanitizer version Kentico.Xperience.WebApp already depends on, so nothing new is pulled
         transitively. Re-check when bumping the Kentico packages. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.995" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Kentico.Xperience.Core.Tests is compiled against NUnit 3.x - do not move to 4.x. -->
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>
